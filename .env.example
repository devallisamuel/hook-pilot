# HTTP port for the API process
PORT=4000

DATABASE_URL=postgres://hookpilot:hookpilot@localhost:55432/hookpilot
REDIS_URL=redis://localhost:56379/0

# Allow endpoints on loopback/private networks. Keep false in production (SSRF protection).
ALLOW_PRIVATE_NETWORKS=true

# Run database migrations when the API boots (guarded by a Postgres advisory lock).
RUN_MIGRATIONS=true

# Delivery tuning
# How long to wait for an endpoint to answer one call.
DELIVERY_TIMEOUT_MS=10000
# When an endpoint doesn't answer: how many extra calls to make, and the pause between them.
# After the last one the delivery becomes UNCERTAIN.
DELIVERY_RETRIES=3
DELIVERY_RETRY_DELAY_MS=2000
WORKER_CONCURRENCY=20
